@model Models.ViewModels.Transport.CreateRegisterViewModel
<div class="modal fade" id="add-vehicle" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="addRecordLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">

			<div class="modal-header">
				<h1 class="modal-title fs-5" id="staticBackdropLabel">Transport Register</h1>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>

			<input type="hidden" id="redirectToListing" value="@Url.Page("Index")" />

			<div class="modal-body">

				<form class="needs-validation" id="frmCreate" enctype="multipart/form-data">
					<div asp-validation-summary="ModelOnly" class="mb-3 text-danger"></div>
					<input name="IsValid" type="hidden" value="@ViewData.ModelState.IsValid.ToString()" />

					<div class="col-lg-12 col-12">
						<div class="form-group">
							<label asp-for="CreateDate" class="control-label"></label>
							<input asp-for="CreateDate"
								   type="date"
								   class="form-control datepicker" id="create-date"
								   readonly />
							<span asp-validation-for="CreateDate" class="text-danger"></span>
						</div>
					</div>

					<div class="col-lg-12 col-12">
						<div class="form-group">
							<label asp-for="VehicleId" class="control-label"></label>
							<select asp-for="VehicleId" required class="form-control select2 ddl-vehicles col-lg-4 col-sm-6 col-12">
								<option>Choose</option>
							</select>
							<span asp-validation-for="VehicleId" class="text-danger"></span>
						</div>
					</div>

					<div class="col-lg-12 col-12">
						<div class="form-group">
							<label asp-for="TimeIn" class="control-label"></label>
							<input asp-for="TimeIn" type="time" class="form-control" id="time-in" />
							<span asp-validation-for="TimeIn" class="text-danger"></span>
						</div>
					</div>

					<div class="col-lg-12 d-grid gap-2 d-md-flex justify-content-md-end">
						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
						<button type="submit" class="btn btn-primary submit-btn create-register" data-save="modal">Create</button>
					</div>

				</form>
			</div>

		</div>
	</div>
</div>

<script type="text/javascript">
	$(document).ready(function () {
		const today = new Date().toISOString().split('T')[0];
		$('#create-date').val(today);
		loadVehicles();
	});

</script>