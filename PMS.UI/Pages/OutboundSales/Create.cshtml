				</select>
				<span asp-validation-for="CreateSales.ProductId" class="text-danger"></span>
			</div>

			<div class="form-group">
				<label asp-for="CreateSales.CloserId" class="control-label">Closed By</label>
				<select asp-for="CreateSales.CloserId" class="form-control select2 ddl-closer" id="closedby">
					<option value="0">Choose</option>
				</select>
				<span asp-validation-for="CreateSales.CloserId" class="text-danger"></span>
			</div>

			<div class="form-group">
				<input type="submit" value="Log Sale" class="btn btn-primary" />
