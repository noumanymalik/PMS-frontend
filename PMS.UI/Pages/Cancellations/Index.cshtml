@page
@using Microsoft.Extensions.Options
@using PMS.UI.Options
@inject IOptions<AppSettings> appSettings

@model PMS.UI.Pages.Cancellation.IndexModel
@{
    var apiEndpoint = appSettings.Value.ApiEndpoint;
    var pageSize = appSettings.Value.DefaultPageSize;
}

@section HeadBlock {
    <link href="~/lib/datatables.net-bs5/datatables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2-bootstrap-5-theme/select2-bootstrap-5-theme.min.css" rel="stylesheet">
    <link href="~/lib/bootstrap-daterangepicker/daterangepicker.min.css" rel="stylesheet">
}

@using System.Security.Claims;
@{
    var employeeId = User.FindFirst(ClaimTypes.Actor)?.Value;
}

<input name="__RequestVerificationToken" type="hidden" value="@HttpContext.Session.GetString("API_Token")">

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">

                <div class="table-title p-2 me-1 mb-1">
                    <div class="col-12">
                        <div class="row">
                            <div class="col-6 col-xs-8">
                                <h4>Sales Cancellation</h4>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-filter">
                    <div class="mb-1">
                        <nav class="navbar navbar-light filter_inputs" style="background-color: transparent;">
                            <form asp-page-handler="Search" method="post" class="col-12">

                                <div class="row align-items-center">
                                    <div class="row col-sm-10">

                                        <div class="filter-group col-sm-4 col-xs-6">
                                            <label>Date</label>
                                            <div id="divDateRange" class="input-group">
                                                <input id="txtDateRange" type="text" class="form-control date-range" placeholder="Select Date Range">
                                                <div class="input-group-text">
                                                    <i class="fa fa-calendar"></i>
                                                </div>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="col-sm-2 mt-auto pt-1">
                                        <button id="btnSearchData" class="input-group-text shadow-none px-4 btn btn-dark"><i class="fa fa-search"></i></button>
                                    </div>

                                </div>

                            </form>
                        </nav>
                    </div>
                </div>             

                <div class="table-responsive">
                    <table class="table table-striped table-hover table-bordered" id="tblSales">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>From</th>
                                <th>RGUs</th>
                                <th>Names</th>
                                <th>Provider</th>
                                <th>Portal</th>
                                <th>Supervisor</th>
                                <th>Action(s)</th>
                            </tr>
                        </thead>
                        <tbody class="table-body">
                        </tbody>
                    </table>

                </div>

                <div class="clearfix"></div>


            </div>
        </div>
    </div>
</div>

<div id="modal-placeholder"></div>

@section ScriptsBlock {
    <partial name="_ValidationScriptsPartial" />
    <script type="text/javascript" src="~/lib/datatables.net/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.js"></script>
    <script type="text/javascript" src="~/lib/select2/js/select2.min.js"></script>
    <script type="text/javascript" src="~/lib/moment.js/moment.min.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap-daterangepicker/daterangepicker.min.js"></script>

    <script type="text/javascript">
        $('a[href="/Cancellations"]').addClass('active');

        var apiEndpoint = '@apiEndpoint';
        var employeeId = '@employeeId';

        $('#btnSearchData').on('click', function (e) {
            e.preventDefault();
            loadData();
        });

        function formatDate(dateString) {
            if (!dateString) return '';

            const date = new Date(dateString);

            return (date.getMonth() + 1).toString().padStart(2, '0') + ' / ' +
                   date.getDate().toString().padStart(2, '0') + ' / ' +
                   date.getFullYear();
        }

       $(function () {
        var modelPlaceholder = $('#modal-placeholder');

          $('#tblSales tbody').on('click', 'a.cancel', function (event) {
            event.preventDefault();

            var url = $(this).data('url');
            $.get(url).done(function (response) {
                modelPlaceholder.html(response);
                modelPlaceholder.find('.modal').modal('show');
            });
        });
         modelPlaceholder.on('click', '.add-cancellation', function (event) {
             event.preventDefault();

             const salesId = $(Id).val();
             let $form = $(this).parents('.modal').find('form');

             var formData = {

                 createDate: $('#create-date').val(),
                 salesId: salesId,
                 employeeId: employeeId,
                 remarks: $('#qa-notes').val(),

             };
             if ($form.validate().form()) {
                 $.blockUI({ baseZ: 1055, message: '<h1>Processing...</h1>' });

                 $.ajax({
                     type: 'POST',
                     url: apiEndpoint + 'Cancellation',
                     contentType: 'application/json; charset=utf-8',
                     dataType: 'json',
                     data: JSON.stringify(formData),
                     headers: {
                         'Authorization': 'Bearer ' + $('input:hidden[name="__RequestVerificationToken"]').val(),
                     },
                     success: function (data) {
                        $.unblockUI();
                        if (data.succeeded) {
                            toastr.success(data.messages[0]);

                            var modalEl = document.getElementById('add-cancellation');
                            var modal = bootstrap.Modal.getInstance(modalEl);

                            if (modal) {
                                modal.hide();
                            }
                            $('#modal-placeholder').empty();
                            $('#tblSales').DataTable().ajax.reload(null, false);
                        }
                        else {
                            toastr.error(data.message);
                        }
                    },
                     error: function (jqXHR, textStatus, errorThrown) {
                         $.unblockUI();
                         var errors = JSON.parse(jqXHR.responseText).errors;
                         $.each(jqXHR.responseJSON.errors, function (field, message) {
                             toastr.error(message);
                         });
                     }
                 }).done(function (result) {
                     console.log(result);
                 });
             }
             });
                  modelPlaceholder.on('shown.bs.modal', function (e) {
                  $('input:text:visible:first', this).focus();

             });
        });

        $(function () {
            var start = moment().subtract(1, 'days');
            var end = moment();

            function cb(start, end) {
                $('#divDateRange input.date-range').val(start.format('D MMM, YYYY') + ' - ' + end.format('D MMM, YYYY'));
            }

            $('#divDateRange').daterangepicker({
                startDate: start,
                endDate: end,
                locale: {
                    monthsShort: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
                    monthNames: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
                },
                ranges: {
                    'Today': [moment(), moment()],
                    'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                }
            }, cb);
        });

        var $dg = {};
        var oTable;

        $(async function () {
                loadData();
        });

        var dtOptions = {
            destroy: true,
            processing: true,
            serverSide: true,
            ordering: true, //false,
            searching: false,
            autoWidth: false,
            lengthChange: false,
            paging: true,
            pageLength: @pageSize,
            responsive: true,
            //order: [[1, "asc"]],
            ajax: {
                url: apiEndpoint + 'Sales/GetSalesList',
                type: 'GET',
                datatype: 'json',
                contentType: 'application/json; charset=utf-8',
                headers: {
                        Authorization: 'Bearer ' + $('input:hidden[name="__RequestVerificationToken"]').val()
                },
                data: (data, settings) => {

                    var api = new $.fn.dataTable.Api(settings);
                    var pageIndex = api === undefined ? 1 : api.page.info().page + 1;
                    var $dateRangeData = $('#divDateRange').data('daterangepicker');
                    var startDate = $dateRangeData !== undefined ? $dateRangeData.startDate.format('MM-DD-YYYY') : moment().subtract(1, 'days').startOf('day').format('YYYY-MM-DD');
                    var endDate = $dateRangeData !== undefined ? $dateRangeData.endDate.format('MM-DD-YYYY') : moment().format('YYYY-MM-DD');

                    return { PageIndex: pageIndex, PageSize: '@pageSize', FromDate: startDate, ToDate: endDate, OrderDirection: 'asc' };
                },
                dataSrc: function (json) {
                    var totalRows = json.rowCount;
                    json.recordsTotal = totalRows;
                    json.recordsFiltered = totalRows;
                    return json.data;
                }
            },
            createdRow: function (row, data, dataIndex) {
                $(row).attr('data-id', data.id);
            },
            columns: [
                {
                    data: '#', sortable: false, width: "5%",
                    render: function (data, type, row, meta) {
                        return meta.row + meta.settings._iDisplayStart + 1;
                    }
                },
                {
                    data: 'createDate',
                    defaultContent: 'N/A',
                    width: '5%',
                    className: 'text-left',
                    render: function (data) {
                        return data ? moment(data).format('MM-DD-YYYY') : 'N/A';
                    }
                },
                { data: 'customerName', defaultContent: 'N/A', width: '15%' },
                { data: 'callerId', defaultContent: 'N/A', width: '5%' },
                { data: 'rgu', defaultContent: 'N/A', width: '5%' },
                { data: 'agentName', defaultContent: 'N/A', width: '15%' },
                { data: 'provider', defaultContent: 'N/A', width: '5%' },
                { data: 'portal', defaultContent: 'N/A', width: '5%' },
                { data: 'supervisor', defaultContent: 'N/A', width: '15%' },
                {
                data: 'id',
                title: 'Action(s)',
                width: '8%',
                render: function (data, type, row) {

                    if (row.isCancelled) {
                        return '<a class="btn btn-sm btn-danger me-2 disabled">' +
                               '<i class="fas fa-ban"></i> ' +
                               '<span class="d-none d-sm-inline">Cancelled</span>' +
                               '</a>';
                    }

                    return '<a data-url="@Url.Page("Index", "CreateCancellation")&id=' + data + '" ' +
                           'class="btn btn-sm btn-outline-primary cancel me-2">' +
                           '<i class="fas fa-pencil"></i> ' +
                           '<span class="d-none d-sm-inline">Cancel</span>' +
                           '</a>';
                    }
                }
            ],
            language: {
                paginate: {
                    previous: 'Prev',
                },
                processing: "Loading Data...",
                zeroRecords: "No matching records found"
            },
        };

        function loadData() {
            oTable = $('#tblSales').dataTable(dtOptions);
        }

    </script>
}

