@page
@using Microsoft.Extensions.Options
@using PMS.UI.Options
@inject IOptions<AppSettings> appSettings
@model PMS.UI.Pages.Attendance.IndexModel
@{
    ViewData["Title"] = "Attendance";
    var apiEndpoint = appSettings.Value.ApiEndpoint;
    var pageSize = appSettings.Value.DefaultPageSize;
}

@section HeadBlock {
    <link href="~/lib/datatables.net-bs5/datatables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
}

@using System.Security.Claims;
@{
    var employeeId = User.FindFirst(ClaimTypes.Actor)?.Value;
}

<div class="page-header">
    <div class="page-title">
        <h4>@ViewData["Title"]</h4>
    </div>

    <input name="__RequestVerificationToken" type="hidden" value="@HttpContext.Session.GetString("API_Token")">

    <div class="page-btn">
        <a class="btn btn-success text-white btn btn-added att-add">
            <i class="fa fa-plus me-2" data-toggle="tooltip" data-placement="left" title="Add New"></i>
            Add New
        </a>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">

                <div class="table-title p-2 me-1 mb-1">
                    <div class="row">
                        <div class="col-sm-4">
                            <h4>List of Attendance</h4>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered" id="tblAttendance">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Legend</th>
                            </tr>
                        </thead>
                        <tbody class="table-body">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section ScriptsBlock {
    <partial name="_ValidationScriptsPartial" />
    <script type="text/javascript" src="~/lib/datatables.net/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.js"></script>
    <script type="text/javascript" src="~/lib/select2/js/select2.min.js"></script>
    <script type="text/javascript" src="~/lib/moment.js/moment.min.js"></script>

    <script type="text/javascript">
        $('a[href="/Attendance"]').addClass('active');

        $(document).ready(function () {
        });

        var apiEndpoint = '@apiEndpoint';
        var employeeId = '@employeeId';

        function goBack() {
            window.location.href = $('#redirectToListing').val();
        }

        $('.att-add').on('click', function (e) {
            window.location.href = '@Url.Page("Create")';
        });

        var $dg = {};
        var oTable;

        $(function () {
           loadData();
        });

        function loadData() {
            oTable = $('#tblAttendance').DataTable({
                destroy: true,
                processing: true,
                serverSide: true,
                ordering: false,
                searching: false,
                autoWidth: false,
                lengthChange: false,
                pageLength: @pageSize,
                ajax: {
                    url: apiEndpoint + 'Presence/AttendanceListbySupervisorId?SupervisorId=' + employeeId,
                    type: 'Get',
                    headers: {
                        'Content-Type': 'application/json',
                        Authorization:
                            'Bearer ' + $('input:hidden[name="__RequestVerificationToken"]').val()
                    },
                    data: (data, settings) => {
                        // debugger;
                        var api = new $.fn.dataTable.Api(settings);
                        var pageIndex = api === undefined ? 1 : api.page.info().page + 1;
                        return { PageIndex: pageIndex, PageSize: @pageSize };
                    },
                    dataSrc: function (json) {
                        var totalRows = json.rowCount;
                        json.recordsTotal = totalRows;
                        json.recordsFiltered = totalRows;
                        return json.data;
                    }
                },
                createdRow: function (row, data, dataIndex) {
                    $(row).attr('data-id', data.id);
                },
                columns: [
                    {
                        data: '#',
                        title: '#',
                        sortable: false, width: "3%",
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    {
                        data: 'attendanceDate',
                        width: '5%',
                        render: function (data) {
                            return moment(data).format('MM/DD/YYYY');
                        }
                    },
                    { data: 'employeeCode', defaultContent: 'N/A', width: '5%' },
                    { data: 'employeeName', defaultContent: 'N/A', width: '10%' },
                    { data: 'legend', defaultContent: 'N/A', width: '5%' },
                ],
                language: {
                    searchPlaceholder: "Search...",
                    search: "",
                    lengthMenu: "_MENU_ &nbsp;items/page"
                }
            });
        }


    </script>

}

