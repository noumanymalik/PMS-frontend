@page
@using Microsoft.Extensions.Options
@using PMS.UI.Options
@inject IOptions<AppSettings> appSettings

@model PMS.UI.Pages.AgentBreak.BreakApprovalModel
@{
    var apiEndpoint = appSettings.Value.ApiEndpoint;
    var pageSize = appSettings.Value.DefaultPageSize;
}

@using System.Security.Claims;
@{
    var employeeId = User.FindFirst(ClaimTypes.Actor)?.Value;
}

@section HeadBlock {
    <link href="~/lib/datatables.net-bs5/datatables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2-bootstrap-5-theme/select2-bootstrap-5-theme.min.css" rel="stylesheet">
    <link href="~/lib/bootstrap-daterangepicker/daterangepicker.min.css" rel="stylesheet">
}

<div class="page-header">
    <div class="page-title">
    </div>
</div>

<input name="__RequestVerificationToken" type="hidden" value="@HttpContext.Session.GetString("API_Token")">

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">

                <div class="table-title p-2 me-1 mb-1">
                    <div class="row">
                        <div class="col-sm-4">
                            <h4>Breaks for Approval</h4>
                        </div>
                    </div>
                </div>

                <div class="table-filter">
                    <div class="mb-1">
                        <nav class="navbar navbar-light filter_inputs" style="background-color: transparent;">
                            <form asp-page-handler="Search" method="post" class="col-12">

                                <div class="row align-items-center">
                                    <div class="row col-sm-10">

                                        <div class="filter-group col-sm-4 col-xs-6">
                                            <label>Date</label>
                                            <div id="divDateRange" class="input-group">
                                                <input id="txtDateRange" type="text" class="form-control date-range" placeholder="Select Date Range">
                                                <div class="input-group-text">
                                                    <i class="fa fa-calendar"></i>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="filter-group col-sm-4 col-xs-6">
                                            <label class="control-label">Employees</label>
                                            <select class="form-control select2 ddl-Employees">
                                                <option>Choose</option>
                                            </select>
                                        </div>

                                    </div>

                                    <div class="col-sm-2 mt-auto pt-1">
                                        <button id="btnSearchData" class="input-group-text shadow-none px-4 btn btn-dark"><i class="fa fa-search"></i></button>
                                    </div>

                                </div>

                            </form>
                        </nav>
                    </div>
                </div>

                <div id="result" class="mt-3"></div>

                <div class="table-responsive">
                    <table class="table table-striped table-hover table-bordered" id="tblBreaks">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Break Type</th>
                                <th>Start Time</th>
                                <th>End Time</th>
                                <th>Duration</th>
                                <th>Action(s)</th>
                            </tr>
                        </thead>
                        <tbody class="table-body">
                        </tbody>
                    </table>

                </div>

                <div class="clearfix"></div>


            </div>
        </div>
    </div>
</div>

@section ScriptsBlock {
    <partial name="_ValidationScriptsPartial" />
    <script type="text/javascript" src="~/lib/datatables.net/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.js"></script>
    <script type="text/javascript" src="~/lib/select2/js/select2.min.js"></script>
    <script type="text/javascript" src="~/lib/moment.js/moment.min.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap-daterangepicker/daterangepicker.min.js"></script>

    <script type="text/javascript">
        $('a[href="/AgentBreak/BreakApproval"]').addClass('active');

        var apiEndpoint = '@apiEndpoint';
        var employeeId = '@employeeId';

        var fromDate = null;
        var toDate = null;
        var agentId = null;

        var isDateSelected = false;

        $(document).ready(function () {
             loadData();
             initEmployees();
        });

        $(function () {
            $('#divDateRange').on('apply.daterangepicker', function (ev, picker) {

                fromDate = picker.startDate.format('MM-DD-YYYY');
                toDate = picker.endDate.format('MM-DD-YYYY');

                isDateSelected = true;
            });

            $('#btnSearchData').on('click', function (e) {
                e.preventDefault();

                if (!isDateSelected) {
                    fromDate = null;
                    toDate = null;
                }

                loadData();
            });

            $(".ddl-Employees").change(function () {
                agentId = $(this).val() || null;
            });

            var start = moment().subtract(1, 'days');
            var end = moment();

            function cb(start, end) {
                $('#divDateRange input.date-range').val(start.format('D MMM, YYYY') + ' - ' + end.format('D MMM, YYYY'));
            }

            $('#divDateRange').daterangepicker({
                startDate: start,
                endDate: end,
                locale: {
                    monthsShort: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
                    monthNames: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
                },
                ranges: {
                    'Today': [moment(), moment()],
                    'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                }
            }, cb);
        });

        function initEmployees() {
            return $.ajax({
                type: 'GET',
                url: apiEndpoint + 'Employee/GetAll',
                dataType: 'json',
                contentType: 'application/json; charset=utf-8',
                headers: {
                    'Authorization': 'Bearer ' + $('input:hidden[name="__RequestVerificationToken"]').val(),
                },
                success: function (response) {

                    var result = response.data.map(function (item) {
                        return { id: item.id, text: item.name };
                    });

                    $('.ddl-Employees').select2({
                        data: result,
                        placeholder: 'Choose',
                        theme: 'bootstrap-5',
                        width: '100%'
                    });
                }
            });
        }

        $(document).on('click', '.approve-btn', function (event) {
            event.preventDefault();

            const recordId = $(this).data('id');

            Swal.fire({
                title: "Approve this break?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, approve"
            }).then((result) => {

                if (!result.isConfirmed) return;

                $.blockUI({ baseZ: 1055, message: '<h5>Processing...</h5>' });

                $.ajax({
                    type: 'PUT',
                    url: apiEndpoint + 'AgentSession/UpdateBreakApproval/',
                    contentType: 'application/json',
                    headers: {
                     'Authorization': 'Bearer ' + $('input:hidden[name="__RequestVerificationToken"]').val(),
                    },
                    data: JSON.stringify({
                        id: recordId,
                        approvalTypeId: 2
                    }),

                    success: function (data) {
                        if (data.succeeded) {
                            toastr.success(data.messages[0]);
                            $('#tblBreaks').DataTable().ajax.reload(null, false);
                        } else {
                            toastr.error(data.messages[0]);
                        }
                    },

                    error: function () {
                        toastr.error('Something went wrong');
                    },

                    complete: function () {
                        $.unblockUI();
                    }
                });
            });
        });

        $(document).on('click', '.reject-btn', function (event) {
            event.preventDefault();

            const recordId = $(this).data('id');

            Swal.fire({
                title: "Reject this break?",
                icon: "warning",
                showCancelButton: true,
                confirmButtonText: "Yes, reject"
            }).then((result) => {

                if (!result.isConfirmed) return;

                $.blockUI({ baseZ: 1055, message: '<h5>Processing...</h5>' });

                $.ajax({
                    type: 'PUT',
                    url: apiEndpoint + 'AgentSession/UpdateBreakApproval/',
                    contentType: 'application/json',
                    headers: {
                      'Authorization': 'Bearer ' + $('input:hidden[name="__RequestVerificationToken"]').val(),
                     },
                    data: JSON.stringify({
                        id: recordId,
                        approvalTypeId: 3
                    }),

                    success: function (data) {
                        if (data.succeeded) {
                            toastr.success(data.messages[0]);
                            $('#tblBreaks').DataTable().ajax.reload(null, false);
                        } else {
                            toastr.error(data.messages[0]);
                        }
                    },

                    complete: function () {
                        $.unblockUI();
                    }
                });
            });
        });

        var $dg = {};
        var oTable;

         function loadData() {

            // destroy if already exists
            if ($.fn.DataTable.isDataTable('#tblBreaks')) {
                $('#tblBreaks').DataTable().destroy();
            }

             oTable = $('#tblBreaks').DataTable(getDtOptions());
        }

          function getDtOptions() {
            return {
                destroy: true,
                processing: true,
                serverSide: true,
                ordering: false,
                searching: false,
                autoWidth: false,
                lengthChange: false,
                pageLength: @pageSize,

                ajax: {
                    url: apiEndpoint + 'AgentSession/GetBreaksListBySupervisorId',
                     contentType: 'application/json',
                     headers: {
                       'Authorization': 'Bearer ' + $('input:hidden[name="__RequestVerificationToken"]').val(),
                      },
                    data: function (data, settings) {
                        var api = new $.fn.dataTable.Api(settings);
                        var pageIndex = api.page.info().page + 1;

                        return {
                            PageIndex: pageIndex,
                            PageSize: @pageSize,
                            fromDate: fromDate,
                            toDate: toDate,
                            employeeId: agentId,
                            supervisorId: employeeId,
                            ApprovalTypeId: 1
                        };
                    },
                    dataSrc: function (json) {
                        var totalRows = json.rowCount;
                        json.recordsTotal = totalRows;
                        json.recordsFiltered = totalRows;
                        return json.data;
                    }
                },

                createdRow: function (row, data) {
                    $(row).attr('data-id', data.id);
                },

                columns: [
                    {
                        data: '#',
                        title: '#',
                        width: "3%",
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    {
                        data: 'sessionDate',
                        width: '5%',
                        render: function (data) {
                            return moment.utc(data).utcOffset(5).format('MM/DD/YYYY');
                        }
                    },
                    { data: 'employeeCode', width: '5%' },
                    { data: 'employeeName', width: '10%' },
                    { data: 'breakName', width: '7%' },
                    {
                        data: 'startTime',
                        width: '7%',
                        render: function (data) {
                            return moment.utc(data).utcOffset(5).format('hh:mm:ss A');
                        }
                    },
                    {
                        data: 'endTime',
                        width: '7%',
                        render: function (data) {
                            return moment.utc(data).utcOffset(5).format('hh:mm:ss A');
                        }
                    },
                    {
                        data: null,
                        width: '7%',
                        render: function (data, type, row) {

                            if (!row.startTime || !row.endTime) {
                                return '00:00:00';
                            }

                            const start = moment.utc(row.startTime);
                            const end = moment.utc(row.endTime);

                            const durationSeconds = end.diff(start, 'seconds');

                            const hours = Math.floor(durationSeconds / 3600);
                            const minutes = Math.floor((durationSeconds % 3600) / 60);
                            const seconds = durationSeconds % 60;

                            return String(hours).padStart(2, '0') + ':' +
                                   String(minutes).padStart(2, '0') + ':' +
                                   String(seconds).padStart(2, '0');
                        }
                    },
                    // { data: 'durationMinutes', width: '5%' },
                    {
                         data: 'id',
                         title: 'Action(s)',
                         width: '10%',
                         render: function (data, type, row, meta) {

                        return '<a data-id="' + data + '" href="#" class="btn btn-sm btn-outline-success approve-btn me-2">' + '<i class="fas fa-check me-1"></i>Approve</a>' +
                               '<a data-id="' + data + '" href="#" class="btn btn-sm btn-outline-danger reject-btn">' + '<i class="fas fa-times me-1"></i>Reject</a>';
                         }
                    }
                ],

                language: {
                    searchPlaceholder: "Search...",
                    search: "",
                    lengthMenu: "_MENU_ &nbsp;items/page"
                }
            };
        }

    </script>
}

