@page
@using Microsoft.Extensions.Options
@using PMS.UI.Options
@inject IOptions<AppSettings> appSettings

@model PMS.UI.Pages.Reports.ClientTransferActivityModel
@{
    var apiEndpoint = appSettings.Value.ApiEndpoint;
    var pageSize = appSettings.Value.DefaultPageSize;
}

@section HeadBlock {
    <link href="~/lib/datatables.net-bs5/datatables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2-bootstrap-5-theme/select2-bootstrap-5-theme.min.css" rel="stylesheet">
    <link href="~/lib/bootstrap-daterangepicker/daterangepicker.min.css" rel="stylesheet">
}

<input name="__RequestVerificationToken" type="hidden" value="@HttpContext.Session.GetString("API_Token")">

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">

                <div class="table-title p-2 me-1 mb-1">
                    <div class="col-12">
                        <div class="row">
                            <div class="col-6 col-xs-8">
                                <h4>The Interstice Log Report</h4>
                            </div>
                            <div class="col-6 col-xs-4">
                                <a href="#" class="btn btn-link float-end text-white print-excel"><i class="fa fa-file-excel fa-2x me-2"></i> <span class="d-none d-sm-block">Export to Excel</span></a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-filter">
                    <div class="mb-1">
                        <nav class="navbar navbar-light filter_inputs" style="background-color: transparent;">
                            <form asp-page-handler="Search" method="post" class="w-100">
                                <div class="row align-items-end">

                                    <div class="col-md-4 col-sm-6">
                                        <label>Date</label>
                                        <div id="divDateRange" class="input-group">
                                            <input id="txtDateRange" type="text"
                                                   class="form-control date-range"
                                                   placeholder="Select Date Range">
                                            <div class="input-group-text">
                                                <i class="fa fa-calendar"></i>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-md-4 col-sm-6">
                                        <label class="control-label">Employees</label>
                                        <select class="form-control select2 ddl-Employees">
                                            <option value="">Choose</option>
                                        </select>
                                    </div>

                                    <div class="col-md-1 col-sm-6">
                                        <label>Report Type</label>
                                        <select id="ddlReportType" class="form-control report-type">
                                            <option value="">All</option>
                                            <option value="TMobile">T-Mobile</option>
                                            <option value="ADT">ADT</option>
                                            <option value="AT&T">AT&T</option>
                                            <option value="Business">Business</option>
                                            <option value="DirectTV">DirectTV</option>
                                            <option value="Viviny">Viviny</option>
                                        </select>
                                    </div>

                                    <div class="col-md-1 col-sm-6">
                                        <label>Helping Hand</label>
                                        <select id="ddlHelpingHand" class="form-control hh-type">
                                            <option value="">All</option>
                                            <option value="1">HH</option>
                                            <option value="2">NON-HH</option>
                                        </select>
                                    </div>

                                    <div class="col-md-1 col-sm-6">
                                        <label>Valid</label>
                                        <select id="ddlValid" class="form-control valid-type">
                                            <option value="">All</option>
                                            <option value="1">Valid</option>
                                        </select>
                                    </div>

                                    <div class="col-md-1 col-sm-2">
                                        <button id="btnSearchData" type="submit"
                                                class="btn btn-dark w-100">
                                            <i class="fa fa-search"></i>
                                        </button>
                                    </div>

                                </div>
                            </form>
                        </nav>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="tblReport">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Date</th>
                                <th>IN</th>
                                <th>OUT</th>
                                <th>Code</th>
                                <th>Names</th>
                                <th>BTN</th>
                                <th>Internet Type</th>
                                <th>Agent Time</th>
                                <th>Forwarded Time</th>
                                <th>Buyer ID</th>
                            </tr>
                        </thead>
                        <tbody class="table-body">
                        </tbody>
                    </table>

                </div>

                <div class="clearfix"></div>

            </div>
        </div>
    </div>
</div>

@section ScriptsBlock {
    <partial name="_ValidationScriptsPartial" />
    <script type="text/javascript" src="~/lib/datatables.net/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.js"></script>
    <script type="text/javascript" src="~/lib/select2/js/select2.min.js"></script>
    <script type="text/javascript" src="~/lib/moment.js/moment.min.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap-daterangepicker/daterangepicker.min.js"></script>

    <script type="text/javascript">
        $('a[href="/Reports/ClientTransferActivity"]').addClass('active');

        var apiEndpoint = '@apiEndpoint';
        var reportType = $('.report-type').val();
        var employeeId = null;
        var helpingHand = null;
        var valid = null;

        var fromDate = moment().subtract(0, 'days').startOf('day').format('YYYY-MM-DD');
        var toDate = moment().subtract(0, 'days').startOf('day').format('YYYY-MM-DD');

        $(document).ready(function () {
            loadReport(fromDate, toDate, employeeId, reportType, helpingHand, valid);
            initEmployees();
        });

        $(function () {

            $('#btnSearchData').on('click', function (e) {
                e.preventDefault();
                var $dateRangeData = $('#divDateRange').data('daterangepicker');
                var startDate = $dateRangeData !== undefined ? $dateRangeData.startDate.format('MM-DD-YYYY') : moment().subtract(1, 'days').startOf('day').format('YYYY-MM-DD');
                var endDate = $dateRangeData !== undefined ? $dateRangeData.endDate.format('MM-DD-YYYY') : moment().format('YYYY-MM-DD');
                loadReport(startDate, endDate, employeeId, reportType, helpingHand, valid);
            });

            $(".ddl-Employees").change(function () {
                employeeId = $('.ddl-Employees').val();
            });

            $("#ddlReportType").change(function () {
                reportType = $('.report-type').val();
            });

            $("#ddlHelpingHand").change(function () {
                helpingHand = $('.hh-type').val();
            });

            $("#ddlValid").change(function () {
                valid = $('.valid-type').val();
            });

            $(".print-excel").click(function () {
                var $dateRangeData = $('#divDateRange').data('daterangepicker');
                var startDate = $dateRangeData !== undefined ? $dateRangeData.startDate.format('MM-DD-YYYY') : moment().subtract(1, 'days').startOf('day').format('YYYY-MM-DD');
                var endDate = $dateRangeData !== undefined ? $dateRangeData.endDate.format('MM-DD-YYYY') : moment().format('YYYY-MM-DD');
                downloadExcel(startDate, endDate, employeeId, reportType, helpingHand, valid);
            });

            var start = moment().subtract(1, 'days');
            var end = moment();

            function cb(start, end) {
                $('#divDateRange input.date-range').val(start.format('D MMM, YYYY') + ' - ' + end.format('D MMM, YYYY'));
            }

            $('#divDateRange').daterangepicker({
                startDate: start,
                endDate: end,
                locale: {
                    monthsShort: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
                    monthNames: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
                },
                ranges: {
                    'Today': [moment(), moment()],
                    'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                }
            }, cb);

        });

        function initEmployees() {
            var apiurl = apiEndpoint + 'Employee/GetAll';
            $.ajax({
                type: 'GET',
                url: apiurl,
                contentType: 'application/json; charset=utf-8',
                dataType: 'json',
                headers: {
                    'Authorization': 'Bearer ' + $('input:hidden[name="__RequestVerificationToken"]').val(),
                },
                success: function (response) {
                    var result = response.data.map(function (item) {
                        return { id: item.id, text: item.name };
                    });
                    $('.ddl-Employees').select2({
                        data: result,
                        placeholder: 'Choose', //Not working
                        theme: 'bootstrap-5',
                        width: '100%',
                    });
                },
                failure: function (response) {
                    toastr.error('error!');
                }
            }).done(function (result) {
            });
        }

        function loadReport(fromDate, toDate, employeeId, reportType, helpingHand, valid) {

            $('#tblReport').DataTable({
                destroy: true,
                processing: true,
                serverSide: false,
                paging: false,
                info: false,
                ordering: false,
                searching: false,
                autoWidth: false,
                lengthChange: false,
                ajax: {
                    url: apiEndpoint + 'Reporting/GetClientTransferActivityReport',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + $('input:hidden[name="__RequestVerificationToken"]').val(),
                    },
                    data: (data, settings) => {
                        var api = new $.fn.dataTable.Api(settings);
                        return { StartDate: fromDate, EndDate: toDate, EmployeeId: employeeId, HelpingHand: helpingHand, ReportType: reportType, Valid: valid };
                    },
                    dataSrc: function (json) {
                        return json;
                    }
                },

                columns: [
                    {
                        data: '#', sortable: false, width: "3%",
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    { data: 'createDate', defaultContent: 'N/A', width: '5%', class: 'col-date', render: function (data, type, row) { return moment(data).format('MM-DD-YYYY'); } },
                    { data: 'in', defaultContent: 'N/A', width: '3%' },
                    { data: 'out', defaultContent: 'N/A', width: '3%' },
                    { data: 'code', defaultContent: 'N/A', width: '5%' },
                    { data: 'names', defaultContent: 'N/A', width: '10%' },
                    { data: 'btn', defaultContent: 'N/A', width: '5%' },
                    { data: 'internetType', defaultContent: 'N/A', width: '20%' },
                    { data: 'agentTime', defaultContent: 'N/A', width: '5%' },
                    { data: 'forwardedTime', defaultContent: 'N/A', width: '5%' },
                    { data: 'buyerId', defaultContent: 'N/A', width: '5%' },
                ],

                language: {
                    searchPlaceholder: "Search...",
                    search: "",
                    lengthMenu: "_MENU_ &nbsp;items/page"
                }
            });
        }

        function downloadExcel(fromDate, toDate, employeeId, reportType, helpingHand, valid) {

            $.ajax({
                url: apiEndpoint + 'Reporting/ClientTransferActivity/download-excel',

                type: 'GET',

                headers: {
                    'Authorization': 'Bearer ' +
                        $('input:hidden[name="__RequestVerificationToken"]').val()
                },

                data: {
                    StartDate: fromDate,
                    EndDate: toDate,
                    EmployeeId: employeeId,
                    ReportType: reportType,
                    HelpingHand: helpingHand,
                    Valid: valid
                },

                xhrFields: {
                    responseType: 'blob'
                },

                success: function (data, status, xhr) {

                    var filename = 'TheIntersticeLog.xlsx';

                    var disposition = xhr.getResponseHeader('Content-Disposition');

                    if (disposition) {
                        var match = disposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);

                        if (match && match[1]) {
                            filename = match[1].replace(/['"]/g, '');
                        }
                    }

                    var blob = new Blob([data], {
                        type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                    });

                    var url = window.URL.createObjectURL(blob);

                    var link = document.createElement('a');
                    link.href = url;
                    link.download = filename;

                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);

                    window.URL.revokeObjectURL(url);
                },

                error: function (xhr, status, error) {

                    if (xhr.response instanceof Blob) {

                        var reader = new FileReader();

                        reader.onload = function () {
                            console.log('API Error:', reader.result);
                        };

                        reader.readAsText(xhr.response);
                    }
                }
            });
        }



    </script>
}
