@page
@using Microsoft.Extensions.Options
@using PMS.UI.Options
@inject IOptions<AppSettings> appSettings

@model PMS.UI.Pages.Reports.TriumvirateTangoOfTelephonyModel
@{
    var apiEndpoint = appSettings.Value.ApiEndpoint;
    var pageSize = appSettings.Value.DefaultPageSize;
}

@section HeadBlock {
    <link href="~/lib/datatables.net-bs5/datatables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
    <link href="~/lib/select2-bootstrap-5-theme/select2-bootstrap-5-theme.min.css" rel="stylesheet">
    <link href="~/lib/bootstrap-daterangepicker/daterangepicker.min.css" rel="stylesheet">
}

<input name="__RequestVerificationToken" type="hidden" value="@HttpContext.Session.GetString("API_Token")">

<div class="row">
    <div class="col-sm-12">
        <div class="card">
            <div class="card-body">

                <div class="table-title p-2 me-1 mb-1">
                    <div class="col-12">
                        <div class="row">
                            <div class="col-6 col-xs-8">
                                <h4>Triumvirate Tango Of Telephony Report</h4>
                            </div>
                            <div class="col-6 col-xs-4">
@*                                 <a data-bs-toggle="tooltip" data-bs-placement="top" data-type="excel" data-ext="xlsx" title="excel" class="download-file download-excel"><i class="fa fa-file-excel fa-2x me-2 text-success"></i></a> *@
                                <a href="#" class="btn btn-link float-end text-white print-excel"><i class="fa fa-file-excel fa-2x me-2"></i> <span class="d-none d-sm-block">Export to Excel</span></a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-filter">
                    <div class="mb-1">
                        <nav class="navbar navbar-light filter_inputs" style="background-color: transparent;">
                            <form asp-page-handler="Search" method="post" class="col-12">

                                <div class="row align-items-center">
                                    <div class="row col-sm-10">

                                        <div class="filter-group col-sm-4 col-xs-6">
                                            <label>Date</label>
                                            <div id="divDateRange" class="input-group">
                                                <input id="txtDateRange" type="text" class="form-control date-range" placeholder="Select Date Range">
                                                <div class="input-group-text">
                                                    <i class="fa fa-calendar"></i>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="filter-group col-sm-4 col-xs-6">
                                            <label>Report Type</label>

                                            <select id="ddlReportType" class="form-control report-type">
                                                <option value="TMobile">TMobile</option>
                                                <option value="ADT">ADT</option>
                                                <option value="AT&T">AT&T</option>
                                            </select>
                                        </div>

                                    </div>

                                    <div class="col-sm-2 mt-auto pt-1">
                                        <button id="btnSearchData" class="input-group-text shadow-none px-4 btn btn-dark"><i class="fa fa-search"></i></button>
                                    </div>

                                </div>

                            </form>
                        </nav>
                    </div>
                </div>
               
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="tblTriumvirateTangoOfTelephony">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Create Date</th>
                                <th>IN</th>
                                <th>OUT</th>
                                <th>Names</th>
                                <th>BTN</th>
                                <th>Internet Type</th>
                                <th>Agent Time</th>
                                <th>Forwarded Time</th>
                                <th>Total XFRS</th>
                                <th>Valid</th>
                            </tr>
                        </thead>
                        <tbody class="table-body">
                        </tbody>
                    </table>

                </div>

                <div class="clearfix"></div>


            </div>
        </div>
    </div>
</div>

@section ScriptsBlock {
    <partial name="_ValidationScriptsPartial" />
    <script type="text/javascript" src="~/lib/datatables.net/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.js"></script>
    <script type="text/javascript" src="~/lib/select2/js/select2.min.js"></script>
    <script type="text/javascript" src="~/lib/moment.js/moment.min.js"></script>
    <script type="text/javascript" src="~/lib/bootstrap-daterangepicker/daterangepicker.min.js"></script>
    <script src="~/js/reports.js" asp-append-version="true"></script>


    <script type="text/javascript">
        $('a[href="/Reports/TriumvirateTangoOfTelephony"]').addClass('active');

        var apiEndpoint = '@apiEndpoint';
        var reportType = $('.report-type').val();

        var fromDate = moment().subtract(1, 'days').startOf('day').format('YYYY-MM-DD');
        var toDate = moment().subtract(1, 'days').startOf('day').format('YYYY-MM-DD');

        $(document).ready(function () {
            loadTriumvirateTangoOfTelephonyReport(reportType, fromDate, toDate);
        });

        $(function () {

            $('#btnSearchData').on('click', function (e) {
                e.preventDefault();
                var $dateRangeData = $('#divDateRange').data('daterangepicker');
                var startDate = $dateRangeData !== undefined ? $dateRangeData.startDate.format('MM-DD-YYYY') : moment().subtract(1, 'days').startOf('day').format('YYYY-MM-DD');
                var endDate = $dateRangeData !== undefined ? $dateRangeData.endDate.format('MM-DD-YYYY') : moment().format('YYYY-MM-DD');
                loadTriumvirateTangoOfTelephonyReport(reportType, startDate, endDate);
            });

            $("#ddlReportType").change(function () {
                reportType = $('.report-type').val();
            });

            $(".print-excel").click(function () {
                var $dateRangeData = $('#divDateRange').data('daterangepicker');
                var startDate = $dateRangeData !== undefined ? $dateRangeData.startDate.format('MM-DD-YYYY') : moment().subtract(1, 'days').startOf('day').format('YYYY-MM-DD');
                var endDate = $dateRangeData !== undefined ? $dateRangeData.endDate.format('MM-DD-YYYY') : moment().format('YYYY-MM-DD');
                downloadTriumvirateTangoOfTelephonyExcel(reportType, startDate, endDate);
            });

            var start = moment().subtract(1, 'days');
            var end = moment();

            function cb(start, end) {
                $('#divDateRange input.date-range').val(start.format('D MMM, YYYY') + ' - ' + end.format('D MMM, YYYY'));
            }

            $('#divDateRange').daterangepicker({
                startDate: start,
                endDate: end,
                locale: {
                    monthsShort: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
                    monthNames: ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"],
                },
                ranges: {
                    'Today': [moment(), moment()],
                    'Yesterday': [moment().subtract(1, 'days'), moment().subtract(1, 'days')],
                    'Last 7 Days': [moment().subtract(6, 'days'), moment()],
                    'Last 30 Days': [moment().subtract(29, 'days'), moment()],
                    'This Month': [moment().startOf('month'), moment().endOf('month')],
                    'Last Month': [moment().subtract(1, 'month').startOf('month'), moment().subtract(1, 'month').endOf('month')]
                }
            }, cb);
        });

        function loadTriumvirateTangoOfTelephonyReport(reportType, fromDate, toDate) {

            $('#tblTriumvirateTangoOfTelephony').DataTable({
                destroy: true,
                processing: true,
                serverSide: false,
                paging: false,
                info: false,
                ordering: false,
                searching: false,
                autoWidth: false,
                lengthChange: false,
                ajax: {
                    url: apiEndpoint + 'Reporting/GetTriumvirateTangoOfTelephonyReport',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': 'Bearer ' + $('input:hidden[name="__RequestVerificationToken"]').val(),
                    },
                    data: (data, settings) => {
                        var api = new $.fn.dataTable.Api(settings);
                        return { ReportType: reportType, StartDate: fromDate, EndDate: toDate };
                    },
                    dataSrc: function (json) {
                        return json;
                    }
                },

                columns: [
                    {
                        data: '#', sortable: false, width: "3%",
                        render: function (data, type, row, meta) {
                            return meta.row + meta.settings._iDisplayStart + 1;
                        }
                    },
                    { data: 'createDate', defaultContent: 'N/A', width: '5%', class: 'col-date', render: function (data, type, row) { return moment(data).format('MM-DD-YYYY'); } },
                    { data: 'in', defaultContent: 'N/A', width: '3%' },
                    { data: 'out', defaultContent: 'N/A', width: '3%' },
                    { data: 'names', defaultContent: 'N/A', width: '10%' },
                    { data: 'btn', defaultContent: 'N/A', width: '5%' },
                    { data: 'internetType', defaultContent: 'N/A', width: '20%' },
                    { data: 'agentTime', defaultContent: 'N/A', width: '5%' },
                    { data: 'forwardedTime', defaultContent: 'N/A', width: '5%' },
                    { data: 'totalXFRS', defaultContent: 'N/A', width: '5%' },
                    { data: 'valid', defaultContent: 'N/A', width: '5%' },
                ],
                
                language: {
                    searchPlaceholder: "Search...",
                    search: "",
                    lengthMenu: "_MENU_ &nbsp;items/page"
                }
            });
        }

        function downloadTriumvirateTangoOfTelephonyExcel(reportType, fromDate, toDate) {

            $.ajax({
                url: apiEndpoint + 'Reporting/TriumvirateTangoOfTelephony/download-excel',

                type: 'GET',

                headers: {
                    'Authorization': 'Bearer ' +
                        $('input:hidden[name="__RequestVerificationToken"]').val()
                },

                data: {
                    ReportType: reportType,
                    StartDate: fromDate,
                    EndDate: toDate
                },

                xhrFields: {
                    responseType: 'blob'
                },

                success: function (data, status, xhr) {

                    var filename = 'TriumvirateTangoOfTelephony.xlsx';

                    var disposition = xhr.getResponseHeader('Content-Disposition');

                    if (disposition) {
                        var match = disposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);

                        if (match && match[1]) {
                            filename = match[1].replace(/['"]/g, '');
                        }
                    }

                    var blob = new Blob([data], {
                        type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                    });

                    var url = window.URL.createObjectURL(blob);

                    var link = document.createElement('a');
                    link.href = url;
                    link.download = filename;

                    document.body.appendChild(link);
                    link.click();
                    document.body.removeChild(link);

                    window.URL.revokeObjectURL(url);
                },

                error: function (xhr, status, error) {

                    if (xhr.response instanceof Blob) {

                        var reader = new FileReader();

                        reader.onload = function () {
                            console.log('API Error:', reader.result);
                        };

                        reader.readAsText(xhr.response);
                    }
                }
            });
        }

    </script>
}
