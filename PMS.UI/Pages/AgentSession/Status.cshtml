}

@using System.Security.Claims;
@{
    var employeeId = User.FindFirst(ClaimTypes.Actor)?.Value;
}

@section HeadBlock {
    <link href="~/lib/datatables.net-bs5/datatables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
}

<input name="__RequestVerificationToken" type="hidden" value="@HttpContext.Session.GetString("API_Token")">

<div class="container-fluid mt-4">

    <!-- ========================= -->
    <!-- Summary Cards -->
    <!-- ========================= -->

    <div class="row g-3 mb-4">

        <!-- Total Agents -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm summary-card" data-status="all" style="cursor:pointer;">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded p-3 me-3 bg-primary bg-opacity-10 text-primary">
                        <i class="fas fa-users fa-lg"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Total Agents
                        </div>

                        <h3 class="mb-0 mt-1" id="total-agents">
                            0
                        </h3>
                    </div>

                </div>
            </div>
        </div>

        <!-- Logged In -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm summary-card" data-status="Logged In" style="cursor:pointer;">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded p-3 me-3 bg-success bg-opacity-10 text-success">
                        <i class="fas fa-headset fa-lg"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Logged In
                        </div>

                        <h3 class="mb-0 mt-1 text-success" id="logged-in-agents">
                            0
                        </h3>
                    </div>

                </div>
            </div>
        </div>

        <!-- Not Logged In -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm summary-card" data-status="Not Logged In" style="cursor:pointer;">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded p-3 me-3 bg-danger bg-opacity-10 text-danger">
                        <i class="fas fa-user-times fa-lg"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            Not Logged In
                        </div>

                        <h3 class="mb-0 mt-1 text-danger" id="not-logged-in-agents">
                            0
                        </h3>
                    </div>

                </div>
            </div>
        </div>

        <!-- On Break -->
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm summary-card" data-status="On Break" style="cursor:pointer;">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded p-3 me-3 bg-warning bg-opacity-10 text-warning">
                        <i class="fas fa-coffee fa-lg"></i>
                    </div>

                    <div>
                        <div class="text-muted small">
                            On Break
                        </div>

                        <h3 class="mb-0 mt-1 text-warning" id="break-agents">
                            0
                        </h3>
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- ========================= -->
    <!-- Agent Attendance -->
    <!-- ========================= -->

    <div class="card border-0 shadow-sm">

        <!-- Header -->
        <div class="card-header bg-white border-0 p-4">
            <div class="d-flex justify-content-between  align-items-center">
                <div>
                    <h5 class="mb-1">
                        <i class="fas fa-user-clock text-primary me-2"></i>
                        Agent Attendance Status
                    </h5>

                    <small class="text-muted">
                        Live agent login and break status
                    </small>

                </div>

                <button type="button" class="btn btn-outline-primary btn-sm" id="btn-refresh">
                    <i class="fas fa-sync-alt me-1"></i>
                    Refresh
                </button>
            </div>
        </div>

        <!-- Table -->
        <div class="card-body pt-0">
            <div class="table-responsive">
                <table id="agent-status-table" class="table table-hover align-middle w-100">
                    <thead>
                        <tr>
                            <th>Agent</th>
                            <th>Employee Code</th>
                            <th>Status</th>
                            <th>Login Time</th>
                            <th>Current Break</th>
                            <th>Break Started</th>
                            <th>Session Duration</th>
                        </tr>
                    </thead>
                    <tbody>
                    </tbody>
                </table>
            </div>
        </div>

    </div>

</div>

@section ScriptsBlock {
    <partial name="_ValidationScriptsPartial" />
    <script type="text/javascript" src="~/lib/datatables.net/jquery.dataTables.min.js"></script>
    <script type="text/javascript" src="~/lib/datatables.net-bs5/dataTables.bootstrap5.min.js"></script>
    <script type="text/javascript" src="~/lib/select2/js/select2.min.js"></script>
    <script type="text/javascript" src="~/lib/moment.js/moment.min.js"></script>

    <script type="text/javascript">
        $('a[href="/AgentSession/Status"]').addClass('active');

        var apiEndpoint = '@apiEndpoint';
        var employeeId = '@employeeId';

        var $dg = {};
        var oTable;

        $(document).ready(function () {
            loadData();
        });

        function loadData() {

            if ($.fn.DataTable.isDataTable('#agent-status-table')) {
                $('#agent-status-table').DataTable().clear().destroy();
            }

            oTable = $('#agent-status-table').DataTable(getDtOptions());
        }

         $(document).on('click', '#btn-refresh', function (event) {
            event.preventDefault();
            debugger
            loadData();
        });

        function getDtOptions() {

            return {
                destroy: true,
                processing: false,
                serverSide: false,
                ordering: true,
                searching: true,
                autoWidth: false,
                lengthChange: false,
                pageLength: @pageSize,

                ajax: {
                    url: apiEndpoint + 'AgentSession/GetDashboardDataBySupervisorId?SupervisorId=' + employeeId,

                    contentType: 'application/json',

                    headers: {
                        'Authorization': 'Bearer ' +
                            $('input:hidden[name="__RequestVerificationToken"]').val()
                    },

                    data: function (data, settings) {

                        var api = new $.fn.dataTable.Api(settings);
                        var pageIndex = api.page.info().page + 1;

                        return {
                            PageIndex: pageIndex,
                            PageSize: @pageSize,
                            SupervisorId: employeeId
                        };
                    },

                    dataSrc: function (json) {

                        // Your API response:
                        // json.data[0] = dashboard
                        // json.data[0].employees = employees

                        if (!json.data || json.data.length === 0) {
                            return [];
                        }

                        var dashboard = json.data[0];

                        // Update dashboard cards
                        $('#total-agents').text(dashboard.totalAgents);
                        $('#logged-in-agents').text(dashboard.loggedIn);
                        $('#not-logged-in-agents').text(dashboard.notLoggedIn);
                        $('#break-agents').text(dashboard.onBreak);

                        // DataTable rows
                        return dashboard.employees || [];
                    }
                },

                columns: [

                    {
                        data: 'name',
                        width: '20%'
                    },

                    {
                        data: 'code',
                        width: '10%'
                    },

                    {
                        data: 'status',
                        width: '13%',

                        render: function (data) {

                            if (data === 'LoggedIn') {

                                return '<span class="badge bg-success">' +
                                    '<i class="fas fa-circle me-1"></i>' +
                                    'Logged In' +
                                    '</span>';
                            }

                            if (data === 'OnBreak') {

                                return '<span class="badge bg-warning text-dark">' +
                                    '<i class="fas fa-coffee me-1"></i>' +
                                    'On Break' +
                                    '</span>';
                            }

                            if (data === 'Offline') {

                                return '<span class="badge bg-secondary">' +
                                    '<i class="fas fa-circle me-1"></i>' +
                                    'Offline' +
                                    '</span>';
                            }

                            return '<span class="badge bg-light text-dark">' +
                                (data || '-') +
                                '</span>';
                        }
                    },

                    {
                        data: 'loginTime',
                        width: '12%',

                        render: function (data) {

                            if (!data) {
                                return '<span class="text-muted">-</span>';
                            }

                            // loginTime is UTC time-only, e.g. 13:59:39.188
                            var parts = data.split(':');

                            if (parts.length < 2) {
                                return data;
                            }

                            var hour = parseInt(parts[0], 10);
                            var minute = parseInt(parts[1], 10);
                            var second = parts.length > 2
                                ? parseInt(parts[2], 10)
                                : 0;

                            // Convert UTC -> Pakistan Time (UTC+5)
                            hour += 5;

                            if (hour >= 24) {
                                hour -= 24;
                            }

                            var period = hour >= 12 ? 'PM' : 'AM';

                            hour = hour % 12;

                            if (hour === 0) {
                                hour = 12;
                            }

                            return String(hour).padStart(2, '0') +
                                ':' +
                                String(minute).padStart(2, '0') +
                                ':' +
                                String(second).padStart(2, '0') +
                                ' ' +
                                period;
                        }
                    },

                    {
                        data: 'currentBreak',
                        width: '15%',

                        render: function (data) {

                            if (!data) {
                                return '<span class="text-muted">-</span>';
                            }

                            return '<span class="fw-semibold">' +
                                data +
                                '</span>';
                        }
                    },

                    {
                        data: 'breakStarted',
                        width: '13%',

                        render: function (data) {

                            if (!data) {
                                return '<span class="text-muted">-</span>';
                            }

                            // If API returns TimeOnly, e.g. 14:25:10
                            var parts = data.split(':');

                            if (parts.length < 2) {
                                return data;
                            }

                            var hour = parseInt(parts[0]);
                            var minute = parts[1];
                            var second = parts[2] || '00';

                            var period = hour >= 12 ? 'PM' : 'AM';

                            hour = hour % 12;

                            if (hour === 0) {
                                hour = 12;
                            }

                            return String(hour).padStart(2, '0') +
                                ':' +
                                minute +
                                ':' +
                                second.substring(0, 2) +
                                ' ' +
                                period;
                        }
                    },

                    {
                        data: 'sessionDuration',
                        width: '17%',

                        render: function (data) {

                            if (!data) {
                                return '<span class="text-muted">-</span>';
                            }

                            // TimeSpan:
                            // 06:11:49.2025963
                            //
                            // Display:
                            // 06:11:49

                            var parts = data.split(':');

                            if (parts.length >= 3) {

                                return '<span class="fw-bold">' +
                                    parts[0] + ':' +
                                    parts[1] + ':' +
                                    parts[2].substring(0, 2) +
                                    '</span>';
                            }

                            return '<span class="fw-bold">' +
                                data +
                                '</span>';
                        }
                    }
                ],

                language: {
                    searchPlaceholder: "Search...",
                    search: "",
                    lengthMenu: "_MENU_ &nbsp;items/page"
                }
            };
        }

    </script>
} *@